# Required for Sanity CMS (blog + /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# Required for the contact forms (Cloudflare Turnstile + Resend email)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFUJOhaP8LbRNF2O
TURNSTILE_SECRET_KEY=
# Comma-separated frontend hostnames accepted at siteverify. Production lists
# only the public domains; local dev uses localhost,127.0.0.1.
TURNSTILE_HOSTNAMES=
RESEND_API_KEY=
